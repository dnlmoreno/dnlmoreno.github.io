---
interface Paper {
  title: string;
  venue: string;
  homeVenue?: string;
  status: string;
  description: string;
  data: string[];
  frameworks: string[];
  github: string | null;
  paper: string | null;
  image: string;
}

interface Props {
  paper: Paper;
  /** Show paper.homeVenue (falling back to paper.venue) instead of paper.venue.
   *  Used on the home page, which displays a more descriptive venue label
   *  without changing what the Research page shows. */
  useHomeVenue?: boolean;
}

const { paper, useHomeVenue = false } = Astro.props as Props;
const venueLabel = useHomeVenue ? paper.homeVenue ?? paper.venue : paper.venue;

const getBadgeClass = (venue: string) => {
  if (venue.includes("ICML")) return "badge-yellow";
  if (venue.includes("Thesis")) return "badge-green";
  if (venue.includes("LARIM")) return "badge-yellow";
  return "badge-blue"; // Default Journals
};
---

<article class="paper-card glass">
  <div class="paper-image-wrapper">
    <img
      src={paper.image.replace("3b82f6", "00e5ff")}
      alt={paper.title}
      class="paper-image"
      loading="lazy"
    />

    <div class="status-badge-container">
      {
        paper.status === "published" ? (
          <span class="status-badge published">Published</span>
        ) : (
          <span class="status-badge in-progress">In Progress</span>
        )
      }
    </div>
  </div>

  <div class="paper-content">
    <span class={`venue-badge ${getBadgeClass(venueLabel)}`}>
      {venueLabel}
    </span>
    <h4 class="paper-title">{paper.title}</h4>
    <p class="paper-desc">{paper.description}</p>

    <div class="paper-chips">
      {paper.data.map((d) => <span class="chip chip-data">{d}</span>)}
      {paper.frameworks.map((f) => <span class="chip chip-framework">{f}</span>)}
    </div>

    <div class="paper-actions">
      {
        paper.paper ? (
          <a
            href={paper.paper}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            Read Paper
          </a>
        ) : (
          <button class="btn btn-primary btn-sm" disabled title="Coming soon">
            Read Paper
          </button>
        )
      }

      {
        paper.github ? (
          <a
            href={paper.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
            GitHub
          </a>
        ) : (
          <button class="btn btn-sm tooltip-trigger" disabled>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
            GitHub
            <span class="tooltip">Coming soon</span>
          </button>
        )
      }
    </div>
  </div>
</article>

<style>
  .paper-card {
    border-radius: 12px;
    overflow: hidden;
    border: var(--surface-border);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .paper-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 229, 255, 0.4);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
  }

  .paper-image-wrapper {
    position: relative;
    width: 100%;
    height: 160px;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .paper-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s ease,
      filter 0.5s ease;
  }

  .paper-card:hover .paper-image {
    transform: scale(1.1);
    filter: brightness(0.6) sepia(100%) hue-rotate(90deg) saturate(300%);
  }

  .status-badge-container {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .status-badge {
    padding: 0.3rem 0.6rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: bold;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .published {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .in-progress {
    background-color: transparent;
    color: var(--color-text);
    border: 1px dashed var(--color-text);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    100% {
      opacity: 0.6;
    }
  }

  .paper-content {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .venue-badge {
    align-self: flex-start;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    margin-bottom: 0.8rem;
  }

  .badge-yellow {
    background-color: rgba(255, 204, 0, 0.1);
    color: #ffcc00;
  }
  .badge-blue {
    background-color: rgba(0, 153, 255, 0.1);
    color: #0099ff;
  }
  .badge-green {
    background-color: rgba(0, 229, 255, 0.1);
    color: var(--color-accent);
  }

  .paper-title {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .paper-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .paper-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .chip {
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .chip-data {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .chip-framework {
    background-color: rgba(0, 229, 255, 0.05);
    border: 1px solid rgba(0, 229, 255, 0.2);
    color: var(--color-accent);
  }

  .paper-actions {
    display: flex;
    gap: 0.8rem;
    margin-top: auto;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    flex: 1;
  }

  .tooltip-trigger {
    position: relative;
  }

  .tooltip-trigger .tooltip {
    visibility: hidden;
    background-color: var(--color-surface);
    color: var(--color-text);
    text-align: center;
    border-radius: 4px;
    padding: 0.4rem 0.8rem;
    position: absolute;
    z-index: 1;
    bottom: 125%;
    left: 50%;
    margin-left: -50px;
    opacity: 0;
    transition: opacity 0.3s;
    font-size: 0.75rem;
    border: 1px solid var(--color-text-muted);
    white-space: nowrap;
  }

  .tooltip-trigger:hover .tooltip {
    visibility: visible;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .paper-desc {
      -webkit-line-clamp: none;
      font-size: 0.9rem;
    }
  }
</style>
