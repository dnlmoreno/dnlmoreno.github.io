---
// Hero.astro - Larger text, unified visual cluster, closer Harvard & photo, centered Earth & satellite
import { papersBloqueA, contributionsBloqueB } from "../data/research.js";
import PaperCard from "./PaperCard.astro";

const publicationsCount = papersBloqueA.length + contributionsBloqueB.length;

// Selected Projects row reuses the same paper data (and card component) as
// the Research page's "First & Second Author Papers" grid, so editing a
// paper's `featured` order (or anything else) in research.js keeps both
// pages in sync automatically.
const featuredPapers = papersBloqueA
  .filter((p) => typeof p.featured === "number")
  .sort((a, b) => a.featured - b.featured);
---

<div class="home-viewport fade-in">
  <!-- 1. Hero Section -->
  <section id="hero" class="hero-section">
    <div class="container hero-container">
      <div class="hero-layout">
        <!-- Column 1: Intro & Bio -->
        <div class="hero-intro">
          <div class="section-tag">// HELLO, I'M</div>

          <h1 class="hero-name">
            Daniel Moreno<br />
            <span class="text-accent">Cartagena</span>
          </h1>

          <div class="hero-role">
            Machine Learning Engineer &amp; Researcher
          </div>

          <p class="hero-summary">
            I apply AI to astronomy and Earth observation, building models,
            tools, and data systems that help scientists extract more from
            data and better understand our planet and the universe.
          </p>

          <div class="hero-actions">
            <a
              href="/CV_oficial.pdf"
              class="btn-cv"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download CV
            </a>

            <a href="/research" class="btn-research">
              View my research &rarr;
            </a>
          </div>

          <!-- Social Links -->
          <div class="social-row">
            <a
              href="https://github.com/dnlmoreno"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="social-circle"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path>
              </svg>
            </a>

            <a
              href="https://linkedin.com/in/danielmorenoc"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="social-circle"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>

            <a
              href="mailto:damoreno.cartagena@gmail.com"
              aria-label="Email"
              class="social-circle"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>

            <a
              href="https://scholar.google.com/citations?user=WUlT8voAAAAJ&hl=es&authuser=1"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Google Scholar"
              class="social-circle"
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Visual Cluster: Photo & Harvard Card tightly bound, with Earth & Satellite centered behind them -->
        <div class="hero-visual-cluster">
          <!-- Earth & Satellite photo backdrop, centered behind Harvard & Photo -->
          <img
            src="/images/earth_satellite.webp"
            alt=""
            class="space-photo-backdrop"
            aria-hidden="true"
            loading="eager"
          />

          <!-- Circular Portrait with Celestial Orbit -->
          <div class="hero-avatar-wrap">
            <div class="orbit-container">
              <div class="celestial-orbit-track">
                <span class="orbit-node node-1"></span>
                <span class="orbit-node node-2"></span>
                <span class="orbit-node node-3"></span>
              </div>
              <div class="celestial-arc-secondary"></div>
              <img
                src="/images/Foto_chill_atacama.jpeg"
                alt="Daniel Moreno Cartagena"
                class="avatar-img"
                loading="eager"
              />
            </div>
          </div>

          <!-- Affiliation Card (Now snug right next to the photo) -->
          <div class="hero-harvard-wrap">
            <div class="harvard-card glass">
              <div class="harvard-header">
                <span class="h-badge">CURRENTLY AT</span>
                <img
                  src="/images/cfa_logo_vertical_reverse.webp"
                  alt="Center for Astrophysics | Harvard & Smithsonian"
                  class="cfa-logo"
                />
              </div>

              <div class="harvard-position">
                SPARK Student / Researcher
              </div>
              <div class="harvard-dates">
                Sep 2026 &ndash; Aug 2027
              </div>

              <div class="harvard-location">
                <svg
                  class="location-pin"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Cambridge, MA &middot; USA</span>
              </div>

              <div class="harvard-quote">
                &ldquo;Using AI and data to build better tools for science.&rdquo;
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Selected Projects Row — horizontal card layout matching reference -->
  <section id="selected-projects" class="projects-section">
    <div class="projects-section-bg" aria-hidden="true"></div>
    <div class="container">
      <div class="projects-header-row">
        <h2 class="section-tag projects-tag">// SELECTED RESEARCH</h2>
      </div>

      <div class="projects-grid">
        {featuredPapers.map((paper) => <PaperCard paper={paper} useHomeVenue />)}
      </div>
    </div>
  </section>

  <!-- 3. Bottom Row: Publications & Interests Unified & Larger -->
  <section id="metrics-grid" class="bottom-grid-section">
    <div class="container">
      <div class="bottom-grid">
        <!-- Joint Impact Area: Publications + Research Interests -->
        <div class="bottom-left-unified">
          <!-- Panel 1: Publications Metric -->
          <div class="grid-panel panel-pubs">
            <div class="panel-tag">// PUBLICATIONS</div>
            <div class="pubs-content">
              <div class="pubs-icon-box">
                <svg
                  width="36"
                  height="44"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div class="pubs-text">
                <div class="metric-num">{publicationsCount}</div>
                <div class="metric-label">Publications</div>
                <div class="metric-sub">(journals + workshops)</div>
              </div>
            </div>
          </div>

          <!-- Divider between Pubs and Interests -->
          <div class="panel-inner-divider" aria-hidden="true"></div>

          <!-- Panel 2: Research Interests -->
          <div class="grid-panel panel-interests">
            <div class="panel-tag">// RESEARCH INTERESTS</div>
            <div class="interests-quad">
              <!-- Item 1: Multimodal Learning -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                </div>
                <div class="interest-title">Multimodal models and representation learning</div>
              </div>

              <!-- Item 2: Scientific Data & Pipelines -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
                    <path d="M3 12a9 3 0 0 0 18 0"></path>
                  </svg>
                </div>
                <div class="interest-title">Scientific Data &amp; Pipelines</div>
              </div>

              <!-- Item 3: LLMs & AI for Science -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                    <line x1="14" y1="4" x2="10" y2="20"></line>
                  </svg>
                </div>
                <div class="interest-title">LLMs &amp; AI for Science</div>
              </div>

              <!-- Item 4: Physics-Informed Neural Networks -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="1"></circle>
                    <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"></path>
                    <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"></path>
                  </svg>
                </div>
                <div class="interest-title">Physics-Informed Neural Networks</div>
              </div>

              <!-- Item 5: Telescope -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m10.065 12.493-6.18 1.318a.934.934 0 0 1-1.108-.702l-.537-2.15a1.07 1.07 0 0 1 .691-1.265l13.504-4.44"></path>
                    <path d="m13.56 11.747 4.332-.924"></path>
                    <path d="m16 21-3.105-6.21"></path>
                    <path d="M16.485 5.94a2 2 0 0 1 1.455-2.425l1.09-.272a1 1 0 0 1 1.212.727l1.515 6.06a1 1 0 0 1-.727 1.213l-1.09.272a2 2 0 0 1-2.425-1.455z"></path>
                    <path d="m6.15 13.87L9 21"></path>
                  </svg>
                </div>
                <div class="interest-title">Astronomy &amp; Astrophysics</div>
              </div>

              <!-- Item 6: Earth Observation -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                    <path d="M2 12h20"></path>
                  </svg>
                </div>
                <div class="interest-title">Earth Observation &amp; Climate</div>
              </div>

              <!-- Item 7: Epidemiology -->
              <div class="interest-col">
                <div class="interest-icon">
                  <svg
                    width="30"
                    height="30"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="4"></circle>
                    <line x1="12" y1="2" x2="12" y2="5"></line>
                    <line x1="12" y1="19" x2="12" y2="22"></line>
                    <line x1="2" y1="12" x2="5" y2="12"></line>
                    <line x1="19" y1="12" x2="22" y2="12"></line>
                    <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"></line>
                    <line x1="16.95" y1="16.95" x2="19.07" y2="19.07"></line>
                    <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"></line>
                    <line x1="16.95" y1="7.05" x2="19.07" y2="4.93"></line>
                  </svg>
                </div>
                <div class="interest-title">Epidemiology</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel 4: Quote Box -->
        <div class="grid-panel panel-quote">
          <div class="quote-mark">&ldquo;</div>
          <blockquote class="manifesto-quote">
            &ldquo;Better data,<br />
            better models,<br />
            more discoveries.&rdquo;
          </blockquote>
          <div class="quote-bar"></div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  /* Home Viewport Cockpit */
  .home-viewport {
    position: relative;
    padding-top: 105px;
    padding-bottom: 2.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 1.8rem;
    overflow-x: hidden;
  }

  .container {
    max-width: var(--max-width, 1600px);
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  /* Mono Header Tags (// COMMENT STYLE) */
  .section-tag {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  /* 1. Hero Section */
  .hero-section {
    position: relative;
    padding: 0.5rem 0 1rem;
    flex: 0 0 auto;
  }

  .hero-container {
    position: relative;
    z-index: 5;
  }

  /* Hero Layout: Intro on Left, Visual Cluster (Photo + Harvard Card) pulled closer */
  .hero-layout {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 3.8rem;
  }

  /* Column 1: Info (Name preserved at 3.3rem, rest scaled up with original Syne font) */
  .hero-intro {
    flex: 0 1 540px;
    max-width: 560px;
  }

  .hero-name {
    font-family: var(--font-mono);
    font-size: 3.3rem; /* Preserved exactly as requested */
    font-weight: 700;
    line-height: 1.08;
    color: #ffffff;
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
  }

  .hero-role {
    font-family: 'Outfit', sans-serif;
    font-size: 1.75rem; /* Scaled up */
    color: #94a3b8;
    font-weight: 600;
    margin-bottom: 1.1rem;
    letter-spacing: 0.01em;
  }

  .hero-summary {
    font-family: var(--font-sans);
    font-size: 1.32rem; /* Scaled up as requested */
    line-height: 1.68;
    color: #8b95a8;
    margin-bottom: 1.8rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .btn-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.6rem;
    background: rgba(0, 203, 226, 0.08);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 1.12rem; /* Scaled up */
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .btn-cv:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    box-shadow: 0 0 18px rgba(0, 203, 226, 0.4);
  }

  .btn-research {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #cbd5e1;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 1.12rem; /* Scaled up */
    font-weight: 500;
    transition: all 0.25s ease;
  }

  .btn-research:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(0, 203, 226, 0.06);
  }

  .social-row {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #8b95a8;
    background: rgba(10, 16, 28, 0.65);
    transition: all 0.25s ease;
  }

  .social-circle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 14px rgba(0, 203, 226, 0.3);
    transform: translateY(-2px);
  }

  /* Visual Cluster: Photo and Harvard card are snug together, Earth & Satellite centered behind them.
     No position set here on purpose — the backdrop image below anchors to .hero-container instead,
     so its right edge lines up exactly with the navbar's container edge (where Contact sits). */
  .hero-visual-cluster {
    display: flex;
    align-items: center;
    gap: 1.8rem; /* Snug gap between photo and Harvard card */
    flex: 0 0 auto;
  }

  /* Earth & Satellite photo backdrop, anchored to the page container so its right edge
     is flush with the navbar's right margin (the Contact button), fading via mask so
     the photo's edges blend into the page background */
  .space-photo-backdrop {
    position: absolute;
    bottom: -18px;
    right: 2rem;
    width: 900px;
    height: auto;
    opacity: 0.95;
    pointer-events: none;
    z-index: 1;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 70% at 62% 42%,
      #000 50%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 70% 70% at 62% 42%,
      #000 50%,
      transparent 100%
    );
  }

  /* Circular Avatar (Enlarged as requested) */
  .hero-avatar-wrap {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .orbit-container {
    position: relative;
    width: 380px;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-img {
    width: 310px; /* Enlarged photo */
    height: 310px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(0, 203, 226, 0.35);
    box-shadow: 0 0 34px rgba(0, 0, 0, 0.92);
    z-index: 2;
  }

  .celestial-orbit-track {
    position: absolute;
    width: 370px;
    height: 370px;
    border-radius: 50%;
    border: 1px solid rgba(0, 203, 226, 0.35);
    z-index: 3;
    pointer-events: none;
    animation: orbit-spin 60s linear infinite;
  }

  .celestial-arc-secondary {
    position: absolute;
    width: 413px;
    height: 347px;
    border-radius: 50%;
    border: 1px dashed rgba(0, 203, 226, 0.22);
    z-index: 1;
    pointer-events: none;
    transform: rotate(-25deg);
  }

  .orbit-node {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  .node-1 {
    top: 39px;
    left: 52px;
  }

  .node-2 {
    bottom: 46px;
    right: 41px;
  }

  .node-3 {
    top: 50%;
    right: -5px;
    transform: translateY(-50%);
  }

  @keyframes orbit-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Harvard Card */
  .hero-harvard-wrap {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: flex-start;
  }

  .harvard-card {
    width: 345px;
    padding: 1.7rem 1.9rem;
    border-radius: 14px;
    border: 1px solid rgba(0, 203, 226, 0.25);
    background: rgba(10, 16, 28, 0.85);
    backdrop-filter: blur(14px);
