---
import { papersBloqueA, contributionsBloqueB } from "../data/research.js";
import PaperCard from "./PaperCard.astro";

// Helper to get badge class based on venue (used only for Bloque B contribution rows below)
const getBadgeClass = (venue: string) => {
  if (venue.includes("ICML")) return "badge-yellow";
  if (venue.includes("Thesis")) return "badge-green";
  if (venue.includes("LARIM")) return "badge-yellow";
  return "badge-blue"; // Default Journals
};
---

<section id="research" class="section research-section">
  <!-- Decorative Abstract Typography & Orbs -->
  <div class="bg-typography right relative-z">RESEARCH</div>
  <div class="bg-orb orb-1"></div>

  <div class="container relative-z z-10">
    <div class="research-header fade-in">
      <h2 class="section-title">
        Research & <span class="text-accent">Publications</span>
      </h2>
    </div>

    <!-- Bloque A: First Author Papers -->
    <div class="research-block fade-in">
      <h3 class="subsection-title">First & Second Author Papers</h3>

      <div class="papers-grid">
        {papersBloqueA.map((paper) => <PaperCard paper={paper} />)}
      </div>
    </div>

    <!-- Bloque B: Contributions -->
    <div class="research-block contributions-block fade-in">
      <h3 class="subsection-title">Contributions & Co-Authored Papers</h3>

      <div class="contributions-list">
        {
          contributionsBloqueB.map((contrib) => (
            <div
              class="contribution-item glass"
            >
              <span class={`venue-badge ${getBadgeClass(contrib.venue)}`}>
                {contrib.year ? `${contrib.year} - ${contrib.venue}` : contrib.venue}
              </span>
              <h4 class="contrib-title" title={contrib.title}>
                {contrib.title}
              </h4>
              <div class="paper-chips inline">
                {contrib.frameworks.map((f) => (
                  <span class="chip chip-framework">{f}</span>
                ))}
              </div>

              <div class="contrib-actions">
                {contrib.paper && (
                  <a
                    href={contrib.paper}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-btn"
                    title="Read Paper"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                      <path d="M14 3v5h5M16 13H8M16 17H8M10 9H8" />
                    </svg>
                  </a>
                )}
                {contrib.github && (
                  <a
                    href={contrib.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-btn"
                    title="GitHub Repo"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .research-section {
    position: relative;
    padding-top: 110px; /* Reduced to push items higher */
    padding-bottom: 2rem;
    overflow: hidden;
  }

  .relative-z {
    position: relative;
  }
  .z-10 {
    z-index: 10;
  }

  /* Decorative Background Setup */
  .bg-typography {
    position: absolute;
    top: 50px;
    right: -10vw;
    font-size: 15vw;
    font-family: var(--font-sans);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.03);
    white-space: nowrap;
    z-index: 1;
    pointer-events: none;
    letter-spacing: 0.1em;
    /* Prevent overflow */
    max-width: 100vw;
    overflow: hidden;
  }

  .bg-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.15;
  }

  .orb-1 {
    width: 350px;
    height: 350px;
    background: var(--color-accent);
    top: 0;
    left: -150px;
  }

  .research-block {
    margin-bottom: 5rem;
  }

  .subsection-title {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
  }

  .research-header {
    margin-bottom: 4rem;
  }

  .research-header .section-title {
    margin-bottom: 0;
  }

  /* Grid Bloque A */
  .papers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  /* Note: the paper-card itself (image, badges, title, desc, actions) is now
     rendered by the shared <PaperCard> component, used here and on the home
     page's Selected Projects row, so both stay in sync automatically. The
     rules below are still needed for Bloque B's contribution rows, which
     reuse the .venue-badge / .chip classes directly in this file's markup. */

  .venue-badge {
    align-self: flex-start;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    margin-bottom: 0.8rem;
  }

  .badge-yellow {
    background-color: rgba(255, 204, 0, 0.1);
    color: #ffcc00;
  }
  .badge-blue {
    background-color: rgba(0, 153, 255, 0.1);
    color: #0099ff;
  }
  .badge-green {
    background-color: rgba(0, 229, 255, 0.1);
    color: var(--color-accent);
  }

  .paper-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
  }

  .paper-chips.inline {
    margin-bottom: 0;
  }

  .chip {
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .chip-data {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .chip-framework {
    background-color: rgba(0, 229, 255, 0.05);
    border: 1px solid rgba(0, 229, 255, 0.2);
    color: var(--color-accent);
  }

  /* Bloque B Strict Alignment Using CSS Grid */
  .contributions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contribution-item {
    display: grid;
    /* Adaptive Column Alignment: Venue Badge -> Title -> Framework Chips -> Action Buttons */
    grid-template-columns: 185px 1fr auto 100px; /* Widened venue column to fit "YYYY - Venue" */
    gap: 1.5rem; /* Reduced gap from 3rem */
    align-items: center;
    padding: 1rem 1.5rem; /* Reduced padding from 1.5rem 2rem */
    border-radius: 8px;
    border: var(--surface-border);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .contribution-item:hover {
    border-color: rgba(0, 229, 255, 0.3);
    background-color: rgba(10, 10, 10, 0.9);
  }

  /* Force venue badge to look good inside its strict column */
  .contribution-item .venue-badge {
    margin-bottom: 0;
    text-align: center;
    justify-self: start;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    width: 100%;
  }

  .contrib-title {
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .contrib-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
  }

  .link-btn {
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .link-btn:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1200px) {
    .papers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .papers-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contribution-item {
      /* Tighten up on tablet/small screens */
      grid-template-columns: 80px 1fr 60px;
      gap: 0.8rem;
    }

    /* Hide chips on smaller screens inside block B */
    .contribution-item .paper-chips {
      display: none;
    }
    
    .bg-typography {
      font-size: 18vw;
      right: -15vw;
      opacity: 0.5;
    }
  }
  @media (max-width: 768px) {
    .section-title {
      font-size: 1.8rem; /* Reduced from 2.2rem */
    }

    .subsection-title {
      font-size: 1.4rem;
      margin-bottom: 1.5rem;
    }

    .papers-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0;
    }

    .bg-typography {
      display: none; /* Hide problematic overflow element on small mobile */
    }

    .contribution-item {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding: 1.5rem;
      text-align: center;
    }

    .contribution-item .venue-badge {
      justify-self: center;
    }

    .contrib-title {
      white-space: normal;
      font-size: 1.1rem;
    }

    .contrib-actions {
      justify-content: center;
    }
  }
  @media (max-width: 600px) {
    .papers-grid {
      grid-template-columns: 1fr;
    }

    .contribution-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }

    .contrib-actions {
      width: 100%;
      justify-content: flex-end;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 0.8rem;
    }
  }
</style>

