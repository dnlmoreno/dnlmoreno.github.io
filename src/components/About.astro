---

---

<section id="about" class="section about-section">
  <!-- Decorative Background Typography -->
  <div class="bg-typography">ABOUT</div>
  <div class="bg-orb orb-1"></div>
  <div class="bg-orb orb-2"></div>

  <div class="container relative-z">
    <!-- Hero Row: Title, Bio, Photo & Galaxy -->
    <div class="about-hero-row fade-in">
      <div class="about-hero-photo">
        <img
          src="/images/scotland_hills.webp"
          alt="Daniel looking out over the Scottish Highlands"
          loading="eager"
        />
      </div>

      <div class="about-header">
        <div class="section-tag">// ABOUT ME</div>
        <h1 class="about-title">
          Curious about <span class="text-accent">what's possible.</span>
        </h1>
        <p class="about-bio">
          I'm fascinated by how AI can advance scientific discovery and make knowledge 
          more accessible. I enjoy exploring new ideas, building useful tools, and 
          developing state-of-the-art models.
        </p>
        <p class="about-bio">
          My goal is to push the boundaries of AI for science by developing reliable systems 
          that turn innovative ideas into meaningful impact. I'm always open to exciting 
          research opportunities, open-source projects, and meaningful collaborations.
        </p>

        <div class="hero-pills">
          <span class="hero-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .52 5.586 3.004 3.004 0 0 0 5.193 2.019A15.822 15.822 0 0 0 12 20a15.822 15.822 0 0 0 2.81-1.5 3.004 3.004 0 0 0 5.193-2.019 4 4 0 0 0 .52-5.586 4 4 0 0 0-2.526-5.77A3 3 0 1 0 12 5Z"></path>
            </svg>
            AI &amp; ML
          </span>
          <span class="hero-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m10.065 12.493-6.18 1.318a.934.934 0 0 1-1.108-.702l-.537-2.15a1.07 1.07 0 0 1 .691-1.265l13.504-4.44"></path>
              <path d="m13.56 11.747 4.332-.924"></path>
              <path d="m16 21-3.105-6.21"></path>
              <path d="M16.485 5.94a2 2 0 0 1 1.455-2.425l1.09-.272a1 1 0 0 1 1.212.727l1.515 6.06a1 1 0 0 1-.727 1.213l-1.09.272a2 2 0 0 1-2.425-1.455z"></path>
              <path d="m6.15 13.87L9 21"></path>
            </svg>
            Astronomy
          </span>
          <span class="hero-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
            Earth Observation
          </span>
        </div>

        <div class="title-underline"></div>
      </div>
    </div>

    <!-- Positioned against .container (.relative-z), not .about-hero-row: the row gets
         a transform once its .fade-in reveal fires, which would otherwise create a new
         containing block for this absolutely-positioned image and throw off its offset. -->
    <img
      src="/images/about_galaxy.webp"
      alt=""
      class="about-galaxy"
      aria-hidden="true"
      loading="eager"
    />

    <!-- Current Work -->
    <div class="focus-row fade-in">
      <div class="glass info-panel">
        <h3 class="panel-heading">
          <svg
            class="panel-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <circle cx="12" cy="12" r="5.2"></circle>
            <circle cx="12" cy="12" r="1.4"></circle>
          </svg>
          Current Work
        </h3>

        <p class="focus-text">
          I'm currently a researcher in the
          <a
            href="https://astroai.cfa.harvard.edu/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent focus-text-link"
            >AstroAI group</a
          > at the Center for Astrophysics | Harvard &amp; Smithsonian,
          working on machine learning methods for
          <strong class="text-accent">Earth observation</strong>. My current
          research focuses on
          <a
            href="https://tempo.si.edu/index.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent focus-text-link"
            >TEMPO (Tropospheric Emissions: Monitoring of Pollution)</a
          >, a NASA satellite instrument that monitors air pollutants across
          North America. I'm developing methods to detect pollution plumes,
          classify atmospheric spectral observations, and explore ways to
          improve the quality and efficiency of satellite data products.
        </p>

        <div class="focus-grid">
          <div class="focus-card">
            <span class="badge-in-progress-sm">
              <span class="badge-dot"></span>
              IN PROGRESS
            </span>
            <h4 class="focus-card-title">TEMPO Atmospheric Segmentation</h4>
            <div class="focus-card-content">
              <div class="focus-card-img">
                <img
                  src="/images/tempo_plumes.svg"
                  alt="TEMPO Atmospheric Segmentation"
                  loading="lazy"
                />
              </div>
              <div class="focus-card-body">
                <p class="focus-card-desc">
                  Identifying NO<sub>2</sub> pollution plumes and classifying
                  spectral pixels in TEMPO observations.
                </p>
                <div class="focus-tags">
                  <span class="tag-chip">NO2 plumes</span>
                  <span class="tag-chip">Clouds &amp; shadows</span>
                  <span class="tag-chip">Snow/ice, dust &amp; smoke</span>
                  <span class="tag-chip">Computer vision</span>
                </div>
              </div>
            </div>
          </div>

          <div class="focus-card">
            <span class="badge-research-sm">
              <span class="badge-dot"></span>
              RESEARCH DIRECTIONS
            </span>
            <h4 class="focus-card-title">TEMPO Data &amp; Retrieval Methods</h4>
            <div class="focus-card-content">
              <div class="focus-card-img">
                <img
                  src="/images/tempo_spectrum.svg"
                  alt="TEMPO Data & Retrieval Methods"
                  loading="lazy"
                />
              </div>
              <div class="focus-card-body">
                <p class="focus-card-desc">
                  Exploring methods to improve the quality, efficiency, and
                  resolution of satellite data products.
                </p>
                <ul class="focus-list">
                  <li>
                    <span class="focus-list-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                      </svg>
                    </span>
                    Missing-value treatment &amp; data cleaning
                  </li>
                  <li>
                    <span class="focus-list-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                      </svg>
                    </span>
                    Spectral compression &amp; denoising
                  </li>
                  <li>
                    <span class="focus-list-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                      </svg>
                    </span>
                    Faster and improved retrieval algorithms
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- My Journey: text on the left, positions in the center, lectures & mentorship on the right -->
    <div class="journey-row fade-in">
      <div class="journey-text">
        <div class="section-tag">// MY JOURNEY</div>
        <h2 class="journey-title">
          From Engineering<br />
          <span class="text-accent">to AI for Science</span>
        </h2>
        <p class="journey-copy">
          My path has been a mix of curiosity, challenging problems and
          great people. Each step has brought me closer to where I am
          today &mdash; building AI for science.
        </p>
      </div>

      <div class="glass info-panel journey-panel">
        <h3 class="panel-heading">
          <svg
            class="panel-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          Career Path
        </h3>
        <div class="timeline timeline-compact">
          <div class="timeline-item">
            <div class="timeline-logo timeline-logo-real">
              <img
                src="/images/cfa_logo_vertical.webp"
                alt="Center for Astrophysics | Harvard & Smithsonian"
              />
            </div>
            <span class="timeline-years">Sep 2026 &ndash; Aug 2027</span>
            <div class="timeline-body">
              <h4>Researcher, SPARK Program - AI &amp; Earth Observation</h4>
              <span class="timeline-org"
                >Center for Astrophysics | Harvard &amp; Smithsonian</span
              >
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-logo timeline-logo-real">
              <img
                src="/images/mingal_logo.webp"
                alt="MINGAL - Núcleo Milenio de Galaxias"
              />
            </div>
            <span class="timeline-years">Jun 2026 &ndash; Aug 2026</span>
            <div class="timeline-body">
              <h4>Research Assistant - AI &amp; Astrophysics</h4>
              <span class="timeline-org"
                >MINGAL (Millennium Nucleus of Galaxies)</span
              >
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-logo timeline-logo-real">
              <img src="/images/alerce_logo.webp" alt="ALeRCE" />
            </div>
            <span class="timeline-years">Oct 2024 &ndash; Aug 2026</span>
            <div class="timeline-body">
              <h4>Machine Learning Engineer - Astronomical Alert Broker</h4>
              <span class="timeline-org"
                >ALeRCE (Automatic Learning for the Rapid Classification of
                Events)</span
              >
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-logo timeline-logo-real">
              <img
                src="/images/seas_logo.webp"
                alt="Harvard John A. Paulson School of Engineering and Applied Sciences"
              />
            </div>
            <span class="timeline-years">Jun 2024 &ndash; Aug 2024</span>
            <div class="timeline-body">
              <h4>Research Fellow - AI &amp; Astrophysics</h4>
              <span class="timeline-org"
                >Harvard John A. Paulson School of Engineering (SEAS)</span
              >
            </div>
          </div>
        </div>

        <button type="button" class="panel-link view-all-btn" id="view-all-journey-btn">
          &rarr; View all positions
        </button>
      </div>

      <div class="glass info-panel lectures-panel">
        <h3 class="panel-heading">
          <svg
            class="panel-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Lectures &amp; Mentorship
        </h3>

        <div class="lectures-compact-list">
          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 2 8l10 5 10-5-10-5z"></path>
                <path d="M6 10v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"></path>
                <line x1="22" y1="8" x2="22" y2="14"></line>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>Deep Learning</h4>
              <span>Universidad de Concepción</span>
            </div>
          </div>

          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>Data Science</h4>
              <span>Universidad de Concepción</span>
            </div>
          </div>

          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .52 5.586 3.004 3.004 0 0 0 5.193 2.019A15.822 15.822 0 0 0 12 20a15.822 15.822 0 0 0 2.81-1.5 3.004 3.004 0 0 0 5.193-2.019 4 4 0 0 0 .52-5.586 4 4 0 0 0-2.526-5.77A3 3 0 1 0 12 5Z"
                ></path>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>Machine Learning</h4>
              <span>Universidad de Concepción</span>
            </div>
          </div>

          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>Data Analytics</h4>
              <span>Universidad de Concepción</span>
            </div>
          </div>

          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>ML Training</h4>
              <span>Harvard University &middot; MACI Internship</span>
            </div>
          </div>

          <div class="lecture-compact-item">
            <div class="lecture-compact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="lecture-compact-body">
              <h4>ML for Engineers</h4>
              <span>Minera Collahuasi</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Arsenal Inside Main Block -->
    <div class="about-skills-row fade-in">
      <h3 class="skills-inline-title">Arsenal & Tech Stack</h3>

      <div class="skills-grid">
        <!-- Category 1 -->
        <div class="skill-category glass">
          <div class="category-header">
            <svg
              class="category-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .52 5.586 3.004 3.004 0 0 0 5.193 2.019A15.822 15.822 0 0 0 12 20a15.822 15.822 0 0 0 2.81-1.5 3.004 3.004 0 0 0 5.193-2.019 4 4 0 0 0 .52-5.586 4 4 0 0 0-2.526-5.77A3 3 0 1 0 12 5Z"
              ></path>
            </svg>
            <h4>Deep Learning & AI</h4>
          </div>
          <div class="skill-tags">
            <span class="tag">PyTorch</span>
            <span class="tag">TensorFlow</span>
            <span class="tag">Hugging Face</span>
            <span class="tag">OpenAI</span>
            <span class="tag">Anthropic</span>
            <span class="tag">Transformers</span>
          </div>
        </div>

        <!-- Category 2 -->
        <div class="skill-category glass">
          <div class="category-header">
            <svg
              class="category-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path></svg
            >
            <h4>RAG & Agents</h4>
          </div>
          <div class="skill-tags">
            <span class="tag">LangChain</span>
            <span class="tag">LlamaIndex</span>
            <span class="tag">Pinecone</span>
            <span class="tag">Milvus</span>
            <span class="tag">pgvector</span>
          </div>
        </div>

        <!-- Category 3 -->
        <div class="skill-category glass">
          <div class="category-header">
            <svg
              class="category-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
                d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path
                d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg
            >
            <h4>Data Engineering</h4>
          </div>
          <div class="skill-tags">
            <span class="tag">SQL / BigQuery</span>
            <span class="tag">Apache Spark</span>
            <span class="tag">Kafka</span>
            <span class="tag">Airflow</span>
            <span class="tag">dbt</span>
          </div>
        </div>

        <!-- Category 4 -->
        <div class="skill-category glass">
          <div class="category-header">
            <svg
              class="category-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-accent)"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="8" rx="2" ry="2"
              ></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"
              ></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line
                x1="6"
                y1="18"
                x2="6.01"
                y2="18"></line></svg
            >
            <h4>MLOps & Cloud</h4>
          </div>
          <div class="skill-tags">
            <span class="tag">AWS / GCP</span>
            <span class="tag">Docker</span>
            <span class="tag">Kubernetes</span>
            <span class="tag">MLflow</span>
            <span class="tag">GitHub Actions</span>
            <span class="tag">FastAPI</span>
          </div>
        </div>
      </div>
    </div>

    <!-- What Drives Me -->
    <div class="drives-row fade-in">
      <div class="drives-text">
        <div class="section-tag">// WHAT DRIVES ME</div>
        <h2 class="journey-title">
          Curiosity, <span class="text-accent">always.</span>
        </h2>
        <p class="journey-copy">
          I'm driven by a simple idea: there's so much we don't know, and
          AI can help us get closer to the answers. Inside and outside of
          work, I find inspiration in science, nature, people and new
          experiences.
        </p>

        <div class="drives-pills-grid">
          <span class="drive-pill">
            <span class="drive-emoji">🏋️</span>
            Gym
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">🎾</span>
            Padel
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">⚽</span>
            Football
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">🍺</span>
            Craft Beer
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">✈️</span>
            Travel
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">📚</span>
            Reading
          </span>
          <span class="drive-pill">
            <span class="drive-emoji">🍥</span>
            Anime
          </span>
        </div>
      </div>

      <div class="drives-photo-wrap">
        <img
          src="/images/edinburgh_scotland.png"
          alt="Edinburgh, Scotland"
          loading="lazy"
        />
        <div class="drives-quote-overlay">
          <blockquote>
            &ldquo;The universe is not only stranger than we imagine, it
            is stranger than we can imagine.&rdquo;
          </blockquote>
          <span class="drives-quote-author">&mdash; J.B.S. Haldane</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Career Timeline Modal -->
  <div class="journey-modal-overlay" id="journey-modal-overlay">
    <div class="journey-modal glass">
      <div class="journey-modal-header">
        <h3 class="panel-heading">
          <svg
            class="panel-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3 2 8l10 5 10-5-10-5z"></path>
            <path d="M6 10v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"></path>
            <line x1="22" y1="8" x2="22" y2="14"></line>
          </svg>
          Full Career Timeline
        </h3>
        <button
          type="button"
          class="journey-modal-close"
          id="journey-modal-close"
          aria-label="Close"
        >
          &times;
        </button>
      </div>

      <div class="journey-modal-body">
        <div class="timeline timeline-compact">
          <div class="timeline-item">
            <div class="timeline-logo timeline-logo-real">
              <img
                src="/images/cfa_logo_vertical.webp"
