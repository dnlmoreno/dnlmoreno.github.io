<script>
  const openJourneyBtn = document.getElementById("view-all-journey-btn");
  const journeyOverlay = document.getElementById("journey-modal-overlay");
  const closeJourneyBtn = document.getElementById("journey-modal-close");

  const openJourneyModal = () => {
    journeyOverlay?.classList.add("is-open");
    document.body.style.overflow = "hidden";
  };

  const closeJourneyModal = () => {
    journeyOverlay?.classList.remove("is-open");
    document.body.style.overflow = "";
  };

  openJourneyBtn?.addEventListener("click", openJourneyModal);
  closeJourneyBtn?.addEventListener("click", closeJourneyModal);

  journeyOverlay?.addEventListener("click", (e) => {
    if (e.target === journeyOverlay) closeJourneyModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeJourneyModal();
  });
</script>

