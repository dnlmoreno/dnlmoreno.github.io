---
// Services.astro
---
<section id="services" class="section services-section">
  <div class="container relative-z">
    <!-- Hero: "What I Work On" plus the 3 service cards, all in one 4-column row,
         so the whole picture is visible together without scrolling. -->
    <div class="svc-hero fade-in">
      <div class="svc-hero-text">
        <h1 class="svc-hero-title">What I <span class="text-accent">Work On</span></h1>
        <p class="svc-hero-desc">
          I work at the intersection of machine learning, data and science.
          I can help with research, engineering and web development
          projects.
        </p>
      </div>

      <div class="svc-cards-row">
        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"></path>
              <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"></path>
            </svg>
          </div>
          <h3>AI & ML Consulting</h3>
          <p>Model design, architecture reviews, and research-to-production guidance.</p>
          <div class="svc-card-tags">Data Analytics &middot; MLOps &middot; State of the Art</div>
        </div>

        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              <path d="M8 10h.01M12 10h.01M16 10h.01"></path>
            </svg>
          </div>
          <h3>AI Agents & RAG Systems</h3>
          <p>LLM-powered agents, RAG pipelines, and chatbots built on your own data.</p>
          <div class="svc-card-tags">RAG &middot; AI Assistants &middot; Workflow Automation</div>
        </div>

        <div class="svc-card">
          <div class="svc-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3>Web Development</h3>
          <p>Websites and portfolios, from personal sites to full product pages.</p>
          <div class="svc-card-tags">Astro &middot; Next.js &middot; React &middot; TypeScript</div>
        </div>
      </div>
    </div>

    <!-- Selected Work: case study -->
    <div class="work-section fade-in">
      <div class="section-tag">// SELECTED WORK</div>

      <a
        href="https://masespacio.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="work-card"
      >
        <div class="work-image">
          <img
            src="/images/masespacio_preview.webp"
            alt="Más Espacio website"
            loading="lazy"
          />
        </div>
        <div class="work-content">
          <span class="work-tag">WEB DEVELOPMENT</span>
          <h4 class="work-title">Más Espacio</h4>
          <p class="work-desc">
            Designed and built the website for Más Espacio, a Chilean science
            outreach collective that brings astronomy and STEM to schools and
            communities across the country, with school-visit bookings, an
            events calendar, and a blog.
          </p>
          <div class="work-tags">Next.js &middot; React &middot; TypeScript</div>
          <span class="work-link">&rarr; Visit site</span>
        </div>
      </a>
    </div>

    <!-- CTA band -->
    <div class="svc-cta fade-in">
      <img
        src="/images/earth_satellite.webp"
        alt=""
        class="svc-cta-photo"
        aria-hidden="true"
        loading="lazy"
      />
      <div class="svc-cta-inner">
        <div class="svc-cta-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
        </div>
        <div class="svc-cta-text">
          <h3>Have an idea or project?</h3>
          <p>I'm always open to discussing research collaborations, new ideas or potential projects.</p>
        </div>
        <a href="/contact" class="svc-cta-btn">
          Get in touch &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    overflow: hidden;
    padding-top: 95px;
    padding-bottom: 80px;
  }

  .relative-z {
    position: relative;
    z-index: 10;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
    display: inline-block;
  }

  /* Hero: title/description on the left, the 3 service cards on the right,
     so everything is visible together on page load without scrolling. */
  .svc-hero {
    display: flex;
    align-items: stretch;
    gap: 2.6rem;
    margin-bottom: 2.5rem;
  }

  .svc-hero-text {
    flex: 0 0 400px;
  }

  .svc-hero-title {
    position: relative;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1.6rem;
  }

  /* Same underline treatment as "Research & Publications" on the Research page
     (.section-title::after in global.css) */
  .svc-hero-title::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60%;
    height: 2px;
    background-color: var(--color-accent);
  }

  .svc-hero-desc {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Service cards, tightly grouped in their own row next to the hero text */
  .svc-cards-row {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 0.9rem;
  }

  .svc-card {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.4rem;
    border-radius: 10px;
    border: 1px solid rgba(0, 229, 255, 0.18);
    background: rgba(0, 229, 255, 0.025);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .svc-card:hover {
    border-color: rgba(0, 229, 255, 0.4);
    background: rgba(0, 229, 255, 0.05);
  }

  .svc-card-icon {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
  }

  .svc-card-icon svg {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .svc-card h3 {
    font-family: var(--font-mono);
    font-size: 1.32rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    margin-bottom: 0.7rem;
  }

  .svc-card p {
    font-family: var(--font-sans);
    font-size: 1.22rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .svc-card-tags {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Selected Work */
  .work-section .section-tag {
    font-size: 1.15rem;
  }

  .work-section {
    margin-bottom: 2.5rem;
  }

  .work-card {
    display: flex;
    gap: 2.2rem;
    align-items: stretch;
    margin-top: 1.4rem;
    padding: 1.6rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.015);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .work-card:hover {
    border-color: rgba(0, 229, 255, 0.4);
    background: rgba(0, 229, 255, 0.04);
    transform: translateY(-3px);
  }

  .work-card:hover .work-link {
    transform: translateX(4px);
    color: #ffffff;
  }

  .work-image {
    flex: 0 0 42%;
    width: 42%;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #050811;
  }

  .work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.4rem 0.4rem 0.4rem 0;
  }

  .work-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
    margin-bottom: 0.9rem;
  }

  .work-title {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .work-desc {
    font-size: 1.42rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.1rem;
  }

  .work-tags {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.3rem;
  }

  .work-link {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  /* CTA band — its own Earth photo, same placeholder-swap note as the hero */
  .svc-cta {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3rem 0;
  }

  .svc-cta-photo {
    position: absolute;
    bottom: -95%;
    right: -9rem;
    width: 560px;
    height: auto;
    max-width: none;
    opacity: 0.5;
    pointer-events: none;
    z-index: 1;
    -webkit-mask-image: linear-gradient(to left, #000 20%, transparent 70%);
    mask-image: linear-gradient(to left, #000 20%, transparent 70%);
  }

  .svc-cta-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .svc-cta-icon {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(0, 229, 255, 0.3);
    background: rgba(0, 229, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svc-cta-icon svg {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
  }

  .svc-cta-text {
    flex: 1;
    min-width: 0;
  }

  .svc-cta-text h3 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .svc-cta-text p {
    font-family: var(--font-sans);
    font-size: 1.42rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .svc-cta-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
    background: rgba(5, 8, 17, 0.75);
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 6px;
    padding: 0.75rem 1.4rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .svc-cta-btn:hover {
    background: rgba(0, 229, 255, 0.1);
    border-color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .svc-hero {
      flex-direction: column;
    }
    .svc-hero-text {
      flex: 0 0 auto;
    }
  }

  @media (max-width: 1024px) {
    .svc-cards-row {
      flex-direction: column;
    }
    .svc-card h3 {
      white-space: normal;
    }
    .work-card {
      flex-direction: column;
    }
    .work-image {
      width: 100%;
      aspect-ratio: 16/9;
    }
    .svc-cta-inner {
      flex-wrap: wrap;
    }
    .svc-cta-btn {
      margin-left: calc(46px + 1.6rem);
    }
  }

  @media (max-width: 768px) {
    .svc-hero-title {
      font-size: 1.9rem;
    }
    .svc-cta-photo {
      display: none;
    }
    .svc-cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .svc-cta-btn {
      margin-left: 0;
    }
  }
</style>
